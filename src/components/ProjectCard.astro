

---
import { Image } from "astro:assets";
import type { Project, ProjectView } from "../data/projects";
import "../styles/project-card.css";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cardTitle = project.cardTitle ?? project.title;
const cardCover = project.cardCover ?? project.cover;

const views: ProjectView[] = [];
if (project.views.research) views.push("research");
if (project.views["art-show"]) views.push("art-show");

const collaborators = project.collaborators
  .split(",")
  .map((name) => name.trim())
  .filter(Boolean);

const detailUrl = (view: ProjectView) =>
  `/project/${project.slug}/${view}/`;
---

<article
  class="project-card"
  data-views={views.join(" ")}
  data-selected={project.selected ? "true" : "false"}
  data-slug={project.slug}
  data-default-view={project.defaultView}
>
  <a
    class="project-card-cover"
    href={detailUrl(project.defaultView)}
    aria-label={`Open ${cardTitle}`}
    data-primary-link
  >
    {cardCover ? (
      <Image src={cardCover} alt={cardTitle} width={750} />
    ) : (
      <span class="project-card-placeholder"></span>
    )}
  </a>

  <div class="project-card-content">
    <div class="project-card-heading">
      <h2>
        <a href={detailUrl(project.defaultView)} data-primary-link>
          {cardTitle}
        </a>
      </h2>
      <span class="project-card-year">{project.year}</span>
    </div>

    <p class="project-card-authors">
      <span class="project-card-marker">@</span>
      <span>
        {collaborators.map((name, index) => (
            <span
            class={
                name.replace(/\*+$/, "").trim() === "Xingyu Li"
                ? "project-card-author-self"
                : "project-card-author-other"
            }
            >
            {index > 0 ? ", " : ""}{name}
            </span>
        ))}
      </span>
    </p>

    <p class="project-card-tags">
      <span class="project-card-marker">#</span>
      <span>{project.tags.join(" ; ")}</span>
    </p>

<div class="project-card-links">
  {views.map((view) => (
    <div class="project-card-outcome-row">
      <span class="project-card-marker">→</span>

    <div class="project-card-outcome-content">
            <a href={detailUrl(view)}>
              View {view === "research" ? "Research" : "Art Show"} ↗
            </a>

            {project.views[view]?.outcomeNotes?.map((note) =>
              note.url ? (
                <a class="project-card-outcome-note" href={note.url}>
                  {note.label}
                </a>
              ) : (
                <span class="project-card-outcome-note">
                  {note.label}
                </span>
              )
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</article>
