---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  active: "project" | "info";
}

const { title, active } = Astro.props;
const siteName = "Xingyu Li";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=dino-white" />
    <title>{title} | {siteName}</title>
  </head>

  <body>
    <SiteHeader siteName={siteName} active={active} />
    <main>
      <slot />
    </main>
  </body>
</html>
